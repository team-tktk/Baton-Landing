---
import Icon from '@/components/Icon.astro'
import { navLinks } from '@/data/content'
import { links, site } from '@/data/site'
---

<header class="nav hero-hidden" data-nav inert>
  <a aria-label={`${site.name} 홈`} class="brand" href="#top">
    <span class="brand-mark"><img alt="" src={site.logo} /></span>
    <span class="brand-text">
      <small>업무 자동 인수인계 서비스</small>
      <strong>{site.name}</strong>
    </span>
  </a>

  <nav aria-label="섹션" class="nav-links">
    {navLinks.map((link) => <a data-nav-link href={link.href}>{link.label}</a>)}
  </nav>

  <div class="nav-actions">
    <a class="btn-dark" href={links.github} rel="noreferrer" target="_blank">BATON 열기</a>

    <button
      aria-controls="nav-menu"
      aria-expanded="false"
      aria-label="메뉴 열기"
      class="nav-toggle"
      data-nav-toggle
      type="button"
    >
      <Icon name="menu" class="icon-open" />
      <Icon name="close" class="icon-close" />
    </button>
  </div>
</header>

<!-- 900px 이하에서 .nav-links를 대신하는 패널. 닫혀 있을 때는 inert라 탭으로 닿지 않습니다. -->
<div class="nav-scrim" data-nav-scrim></div>

<nav aria-label="섹션" class="nav-menu" data-nav-menu id="nav-menu" inert>
  {
    navLinks.map((link) => (
      <a data-nav-menu-link href={link.href}>
        <span>{link.label}</span>
        <Icon name="arrow" />
      </a>
    ))
  }

  <div class="nav-menu-cta">
    <a class="btn-dark" href={links.github} rel="noreferrer" target="_blank">
      BATON 열기
      <Icon name="arrow" />
    </a>
  </div>
</nav>

<style>
  .nav {
    position: fixed;
    z-index: 30;
    top: 0;
    left: 0;
    display: grid;
    width: 100%;
    height: 64px;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 24px;
    transform: none;
    border: 0;
    border-bottom: 1px solid rgb(255 255 255 / 76%);
    border-radius: 0;
    background: rgb(255 255 255 / 58%);
    backdrop-filter: blur(24px) saturate(1.25);
    -webkit-backdrop-filter: blur(24px) saturate(1.25);
    padding: 0 max(18px, calc((100vw - 1180px) / 2));
    box-shadow: 0 10px 30px rgb(23 32 51 / 8%);
    transition:
      opacity 0.55s var(--ease-out),
      transform 0.65s var(--ease-out),
      background 0.3s,
      border-color 0.3s,
      box-shadow 0.3s;
  }

  .nav.hero-hidden {
    opacity: 0;
    transform: translateY(-130%);
    pointer-events: none;
  }

  /* 스크롤하면 배경을 씌워 본문과 분리합니다. */
  .nav.scrolled {
    border-color: rgb(255 255 255 / 72%);
    background: rgb(255 255 255 / 72%);
    box-shadow: 0 12px 34px rgb(23 32 51 / 10%);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 13px;
    text-decoration: none;
  }

  .brand-mark {
    display: grid;
    width: 40px;
    height: 40px;
    place-items: center;
    border: 0;
    border-radius: 50%;
    background: linear-gradient(145deg, var(--surface), var(--blue-2));
    box-shadow: 0 10px 24px rgb(49 130 246 / 12%);
    transition: transform 0.3s var(--ease-out);
  }

  .brand:hover .brand-mark {
    transform: scale(1.12);
  }

  .brand-mark img {
    width: 34px;
    height: 34px;
    object-fit: contain;
  }

  .brand-text small,
  .brand-text strong {
    display: block;
  }

  .brand-text small {
    display: none;
  }

  .brand-text strong {
    color: var(--navy);
    font-size: 16px;
    font-weight: 800;
    letter-spacing: 0.025em;
  }

  .nav-links {
    position: relative;
    display: flex;
    justify-content: center;
    gap: 2px;
  }

  .nav-links a {
    position: relative;
    z-index: 1;
    border-radius: 10px;
    color: var(--sub);
    padding: 9px 14px;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    transition: color 0.2s;
  }

  .nav-links a:hover,
  .nav-links a.active {
    color: var(--blue-dark);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
  }

  .nav-actions .btn-ghost,
  .nav-actions .btn-dark {
    height: 40px;
    border-radius: 999px;
    font-size: 12px;
  }

  /* ===== 모바일 메뉴 ===== */

  /* 햄버거 버튼. 900px 이하에서만 나타납니다. */
  .nav-toggle {
    position: relative;
    display: none;
    width: 40px;
    height: 40px;
    align-items: center;
    justify-content: center;
    border: 1px solid rgb(49 130 246 / 18%);
    border-radius: 999px;
    background: var(--blue-1);
    cursor: pointer;
    padding: 0;
    color: var(--blue-dark);
    transition: background 0.18s, border-color 0.18s, color 0.18s;
  }

  .nav-toggle:hover {
    border-color: rgb(49 130 246 / 38%);
    background: var(--blue-2);
  }

  .nav-toggle :global(svg) {
    position: absolute;
    width: 22px;
    height: 22px;
    transition: opacity 0.2s, transform 0.25s var(--ease-out);
  }

  /* 열림 상태에서 햄버거와 X를 맞바꿉니다. */
  .nav-toggle :global(.icon-close),
  .nav-toggle[aria-expanded='true'] :global(.icon-open) {
    opacity: 0;
    transform: rotate(-45deg);
  }

  .nav-toggle[aria-expanded='true'] :global(.icon-close) {
    opacity: 1;
    transform: none;
  }

  .nav-toggle[aria-expanded='true'] {
    border-color: var(--navy);
    background: var(--navy);
    color: var(--surface);
  }

  .nav-scrim {
    position: fixed;
    z-index: 28;
    display: none;
    inset: 0;
    background: rgb(23 32 51 / 32%);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s;
  }

  .nav-scrim.open {
    opacity: 1;
    pointer-events: auto;
  }

  .nav-menu {
    position: fixed;
    z-index: 29;
    top: var(--nav-h);
    right: 0;
    left: 0;
    display: none;
    max-height: calc(100dvh - var(--nav-h));
    flex-direction: column;
    overflow-y: auto;
    border: 0;
    border-bottom: 1px solid rgb(23 32 51 / 9%);
    border-radius: 0 0 24px 24px;
    background: rgb(255 255 255 / 94%);
    padding: 10px max(6vw, 32px) 22px;
    opacity: 0;
    transform: translateY(-12px);
    box-shadow: 0 22px 44px rgb(23 32 51 / 14%);
    backdrop-filter: blur(24px) saturate(1.2);
    -webkit-backdrop-filter: blur(24px) saturate(1.2);
    pointer-events: none;
    transition: opacity 0.25s, transform 0.3s var(--ease-out);
  }

  .nav-menu.open {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .nav-menu > a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    border-bottom: 1px solid var(--line);
    color: var(--body);
    padding: 18px 4px;
    font-size: 17px;
    font-weight: 750;
    text-decoration: none;
    transition: color 0.18s;
  }

  .nav-menu > a:last-of-type {
    border-bottom: 0;
  }

  .nav-menu > a :global(svg) {
    width: 18px;
    height: 18px;
    color: var(--muted);
    transition: transform 0.2s var(--ease-out), color 0.18s;
  }

  .nav-menu > a:hover,
  .nav-menu > a.active {
    color: var(--blue-dark);
  }

  .nav-menu > a:hover :global(svg),
  .nav-menu > a.active :global(svg) {
    transform: translateX(3px);
    color: var(--blue);
  }

  .nav-menu-cta {
    padding-top: 18px;
  }

  .nav-menu-cta .btn-dark {
    width: 100%;
    height: 50px;
    justify-content: center;
    font-size: 15px;
    box-shadow: 0 12px 26px rgb(23 32 51 / 18%);
  }

  .nav-menu-cta .btn-dark :global(svg) {
    width: 18px;
    height: 18px;
    flex: 0 0 auto;
  }

  /* 메뉴가 열린 동안 뒤 본문이 스크롤되지 않게 합니다.
     html은 이 컴포넌트 밖이라 :global()이 필요합니다. */
  :global(html.menu-open) {
    overflow: hidden;
  }

  @media (max-width: 900px) {
    .nav {
      grid-template-columns: auto minmax(0, 1fr);
    }

    .nav-links {
      display: none;
    }

    .nav-toggle {
      display: inline-flex;
    }

    .nav-scrim {
      display: block;
    }

    .nav-menu {
      display: flex;
    }

    /* 열린 메뉴는 헤더와 틈 없이 이어지는 하나의 시트로 보이게 합니다. */
    .nav.menu-open {
      border-bottom-color: transparent;
      background: rgb(255 255 255 / 94%);
      box-shadow: none;
    }

    .nav.menu-open .nav-actions > .btn-dark {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .nav {
      top: 0;
      width: 100%;
      height: var(--nav-h);
      padding: 0 12px;
      border-radius: 0;
    }

    .brand-text {
      display: none;
    }

    .nav-actions .btn-ghost,
    .nav-actions .btn-dark {
      height: 40px;
      padding: 0 13px;
    }

    .nav-menu {
      padding-right: 24px;
      padding-left: 24px;
    }
  }
</style>

<script>
  import { initNav } from '@/scripts/nav'

  initNav()
</script>
