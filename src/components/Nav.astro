---
import Icon from '@/components/Icon.astro'
import { navLinks } from '@/data/content'
import { links, site } from '@/data/site'
---

<header class="nav" data-nav>
  <a aria-label={`${site.name} 홈`} class="brand" href="#top">
    <span class="brand-mark"><img alt="" src={site.logo} /></span>
    <span class="brand-text">
      <small>업무 자동 인수인계 서비스</small>
      <strong>{site.name}</strong>
    </span>
  </a>

  <nav aria-label="섹션" class="nav-links">
    {navLinks.map((link) => <a data-nav-link href={link.href}>{link.label}</a>)}
    <span aria-hidden="true" class="nav-indicator" data-nav-indicator></span>
  </nav>

  <div class="nav-actions">
    <a class="btn-ghost" href={links.app} rel="noreferrer" target="_blank">로그인</a>
    <a class="btn-dark" href={links.app} rel="noreferrer" target="_blank">회원가입</a>

    <button
      aria-controls="nav-menu"
      aria-expanded="false"
      aria-label="메뉴 열기"
      class="nav-toggle"
      data-nav-toggle
      type="button"
    >
      <Icon name="menu" class="icon-open" />
      <Icon name="close" class="icon-close" />
    </button>
  </div>
</header>

<!-- 900px 이하에서 .nav-links를 대신하는 패널. 닫혀 있을 때는 inert라 탭으로 닿지 않습니다. -->
<div class="nav-scrim" data-nav-scrim></div>

<nav aria-label="섹션" class="nav-menu" data-nav-menu id="nav-menu" inert>
  {
    navLinks.map((link) => (
      <a data-nav-menu-link href={link.href}>
        <span>{link.label}</span>
        <Icon name="arrow" />
      </a>
    ))
  }

  <div class="nav-menu-cta">
    <a class="btn-primary" href={links.app} rel="noreferrer" target="_blank">
      회원가입
      <Icon name="arrow" />
    </a>
  </div>
</nav>

<style>
  .nav {
    position: fixed;
    z-index: 30;
    inset: 0 0 auto;
    display: grid;
    height: var(--nav-h);
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 24px;
    border-bottom: 1px solid transparent;
    background: rgb(255 255 255 / 0%);
    padding: 0 max(6vw, 32px);
    transition: background 0.3s, border-color 0.3s, box-shadow 0.3s;
  }

  /* 스크롤하면 배경을 씌워 본문과 분리합니다. */
  .nav.scrolled {
    border-color: rgb(25 31 40 / 6%);
    background: rgb(255 255 255 / 82%);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow: 0 6px 24px rgb(23 32 51 / 5%);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 13px;
    text-decoration: none;
  }

  .brand-mark {
    display: grid;
    width: 48px;
    height: 48px;
    place-items: center;
    border: 1px solid rgb(49 130 246 / 11%);
    border-radius: 15px;
    background: linear-gradient(145deg, var(--surface), var(--blue-2));
    box-shadow: 0 10px 24px rgb(49 130 246 / 12%);
    transition: transform 0.3s var(--ease-out);
  }

  .brand:hover .brand-mark {
    transform: rotate(-8deg) scale(1.05);
  }

  .brand-mark img {
    width: 40px;
    height: 40px;
    object-fit: contain;
  }

  .brand-text small,
  .brand-text strong {
    display: block;
  }

  .brand-text small {
    margin-bottom: 4px;
    color: var(--blue-dark);
    font-size: 12px;
    font-weight: 750;
  }

  .brand-text strong {
    color: var(--navy);
    font-size: 18px;
    font-weight: 800;
    letter-spacing: 0.025em;
  }

  .nav-links {
    position: relative;
    display: flex;
    justify-content: center;
    gap: 2px;
  }

  .nav-links a {
    position: relative;
    z-index: 1;
    border-radius: 10px;
    color: var(--sub);
    padding: 9px 14px;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    transition: color 0.2s;
  }

  .nav-links a:hover,
  .nav-links a.active {
    color: var(--blue-dark);
  }

  /* 현재 섹션 링크를 따라 미끄러지는 알약 */
  .nav-indicator {
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 100%;
    border-radius: 10px;
    background: var(--blue-faint);
    opacity: 0;
    transition: transform 0.35s var(--ease-out), width 0.35s var(--ease-out), opacity 0.2s;
  }

  .nav-indicator.on {
    opacity: 1;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
  }

  .nav-actions .btn-ghost,
  .nav-actions .btn-dark {
    height: 44px;
    font-size: 13px;
  }

  /* ===== 모바일 메뉴 ===== */

  /* 햄버거 버튼. 900px 이하에서만 나타납니다. */
  .nav-toggle {
    position: relative;
    display: none;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    border: 1px solid rgb(25 31 40 / 10%);
    border-radius: 12px;
    background: var(--surface);
    cursor: pointer;
    padding: 0;
    color: var(--body);
    transition: background 0.18s, border-color 0.18s;
  }

  .nav-toggle:hover {
    border-color: rgb(49 130 246 / 40%);
    background: var(--blue-1);
  }

  .nav-toggle :global(svg) {
    position: absolute;
    width: 22px;
    height: 22px;
    transition: opacity 0.2s, transform 0.25s var(--ease-out);
  }

  /* 열림 상태에서 햄버거와 X를 맞바꿉니다. */
  .nav-toggle :global(.icon-close),
  .nav-toggle[aria-expanded='true'] :global(.icon-open) {
    opacity: 0;
    transform: rotate(-45deg);
  }

  .nav-toggle[aria-expanded='true'] :global(.icon-close) {
    opacity: 1;
    transform: none;
  }

  .nav-scrim {
    position: fixed;
    z-index: 28;
    display: none;
    inset: 0;
    background: rgb(23 32 51 / 32%);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s;
  }

  .nav-scrim.open {
    opacity: 1;
    pointer-events: auto;
  }

  .nav-menu {
    position: fixed;
    z-index: 29;
    top: var(--nav-h);
    right: 0;
    left: 0;
    display: none;
    max-height: calc(100dvh - var(--nav-h));
    flex-direction: column;
    overflow-y: auto;
    border-bottom: 1px solid var(--line);
    border-radius: 0 0 20px 20px;
    background: var(--surface);
    padding: 10px max(6vw, 32px) 20px;
    opacity: 0;
    transform: translateY(-12px);
    box-shadow: 0 20px 40px rgb(23 32 51 / 12%);
    pointer-events: none;
    transition: opacity 0.25s, transform 0.3s var(--ease-out);
  }

  .nav-menu.open {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .nav-menu > a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    border-bottom: 1px solid var(--line);
    color: var(--body);
    padding: 17px 4px;
    font-size: 16px;
    font-weight: 700;
    text-decoration: none;
    transition: color 0.18s;
  }

  .nav-menu > a:last-of-type {
    border-bottom: 0;
  }

  .nav-menu > a :global(svg) {
    width: 18px;
    height: 18px;
    color: var(--muted);
    transition: transform 0.2s var(--ease-out), color 0.18s;
  }

  .nav-menu > a:hover,
  .nav-menu > a.active {
    color: var(--blue-dark);
  }

  .nav-menu > a:hover :global(svg),
  .nav-menu > a.active :global(svg) {
    transform: translateX(3px);
    color: var(--blue);
  }

  .nav-menu-cta {
    padding-top: 14px;
  }

  .nav-menu-cta .btn-primary {
    width: 100%;
    height: 50px;
  }

  /* 메뉴가 열린 동안 뒤 본문이 스크롤되지 않게 합니다.
     html은 이 컴포넌트 밖이라 :global()이 필요합니다. */
  :global(html.menu-open) {
    overflow: hidden;
  }

  @media (max-width: 900px) {
    .nav {
      grid-template-columns: auto minmax(0, 1fr);
    }

    .nav-links {
      display: none;
    }

    .nav-toggle {
      display: inline-flex;
    }

    .nav-scrim {
      display: block;
    }

    .nav-menu {
      display: flex;
    }
  }

  @media (max-width: 560px) {
    .nav {
      padding: 0 16px;
    }

    .brand-text {
      display: none;
    }

    .nav-actions .btn-ghost,
    .nav-actions .btn-dark {
      height: 40px;
      padding: 0 13px;
    }
  }
</style>

<script>
  import { initNav } from '@/scripts/nav'

  initNav()
</script>
