---
import Icon from '@/components/Icon.astro'
import HandoverMotion from '@/components/HandoverMotion.astro'
import { links, site } from '@/data/site'
---

<section class="hero" data-hero id="hero">
  <div class="hero-viewport" data-hero-viewport>
    <canvas aria-hidden="true" class="particle-canvas" data-hero-particles></canvas>

    <div class="hero-content" data-hero-content>
      <h1>
        사람이 떠나도,<br />
        <span>업무는 이어지도록.</span>
      </h1>
    </div>

    <div class="hero-brand" data-hero-brand inert>
      <div class="hero-brand-copy">
        <h2>
          <strong>AI 기반 인수인계</strong><br />
          자동화 서비스 <b>{site.name}</b>
        </h2>
      </div>

      <div class="hero-actions">
        <a class="btn-dark btn-lg" href="#pricing">
          무료로 도입하기
          <Icon name="arrow" />
        </a>
        <a class="btn-glass btn-lg" href={links.app} rel="noreferrer" target="_blank">
          서비스 바로가기
          <Icon name="arrow" />
        </a>
      </div>

      <HandoverMotion />

    </div>

    <a class="scroll-next" data-hero-next href="#problem" aria-label="BATON 서비스 보기">
      <Icon name="arrow" />
    </a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 255svh;
    background: var(--surface);
  }

  .hero-viewport {
    position: sticky;
    top: 0;
    overflow: hidden;
    width: 100%;
    height: 100svh;
    min-height: 620px;
    background: var(--surface);
    isolation: isolate;
  }

  .particle-canvas {
    position: absolute;
    z-index: 0;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .hero-content {
    position: absolute;
    z-index: 1;
    top: 50%;
    left: 50%;
    width: min(1040px, calc(100% - 40px));
    text-align: center;
    transform: translate(-50%, -47%);
    will-change: opacity, transform;
  }

  .hero-brand {
    position: absolute;
    z-index: 1;
    top: 50%;
    left: 50%;
    display: flex;
    width: min(1220px, calc(100% - 64px));
    flex-direction: column;
    align-items: center;
    gap: clamp(16px, 2vh, 24px);
    color: var(--navy-deep);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translate(-50%, -50%) scale(0.76);
    transform-origin: center;
    will-change: opacity, transform;
  }

  .hero-brand-copy {
    width: min(100%, 960px);
    margin: 0 0 16px;
    text-align: center;
  }

  .hero-brand-copy p {
    margin: 0;
    color: var(--navy-deep);
    font-size: clamp(25px, 3.15vw, 50px);
    font-weight: 420;
    line-height: 1.28;
    letter-spacing: -0.045em;
  }

  .hero-brand-copy h2 {
    margin: 0;
    color: var(--navy-deep);
    font-size: clamp(46px, 5vw, 78px);
    font-weight: 430;
    line-height: 1.18;
    letter-spacing: -0.055em;
  }

  .hero-brand-copy h2 strong,
  .hero-brand-copy h2 b {
    font-weight: 850;
  }

  .hero-brand-copy h2 b {
    color: var(--blue);
  }

  h1 {
    margin: 0;
    color: var(--navy-deep);
    font-size: clamp(54px, 7.2vw, 108px);
    font-weight: 850;
    line-height: 0.98;
    letter-spacing: -0.065em;
    text-shadow: 0 2px 28px rgb(255 255 255 / 92%);
  }

  h1 span {
    color: var(--blue-dark);
  }

  .hero-actions {
    display: flex;
    align-self: center;
    justify-content: center;
    gap: 10px;
    margin-top: -6px;
    flex: 0 0 auto;
  }

  .hero-actions a {
    min-width: 154px;
    border-radius: 999px;
    box-shadow: 0 12px 28px rgb(23 32 51 / 12%);
  }

  .hero-actions :global(svg) {
    width: 17px;
    height: 17px;
  }

  .btn-glass {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border: 1px solid rgb(23 32 51 / 20%);
    background: rgb(255 255 255 / 38%);
    backdrop-filter: none;
    color: var(--navy-deep);
    box-shadow: none;
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
    transition: background 0.18s, border-color 0.18s, color 0.18s,
      transform 0.18s var(--ease-out);
  }

  .hero-actions .btn-glass {
    box-shadow: none;
  }

  .btn-glass:hover {
    border-color: rgb(49 130 246 / 52%);
    background: rgb(255 255 255 / 82%);
    color: var(--blue-dark);
    transform: translateY(-1px);
  }

  .btn-glass :global(svg) {
    fill: none;
    stroke: currentColor;
    transition: transform 0.18s var(--ease-out);
  }

  .btn-glass:hover :global(svg) {
    transform: translateX(3px);
  }

  .scroll-next {
    position: absolute;
    z-index: 2;
    bottom: 26px;
    left: 50%;
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    transform: translateX(-50%);
    border: 1px solid rgb(25 31 40 / 18%);
    border-radius: 50%;
    background: rgb(255 255 255 / 48%);
    backdrop-filter: blur(8px);
    color: var(--navy);
    transition: opacity 0.3s, border-color 0.18s, background 0.18s,
      transform 0.18s var(--ease-out);
  }

  .scroll-next:hover {
    border-color: rgb(49 130 246 / 55%);
    background: rgb(255 255 255 / 82%);
    transform: translate(-50%, -1px);
  }

  .scroll-next :global(svg) {
    width: 17px;
    height: 17px;
    transform: rotate(90deg);
    stroke-width: 1.5;
  }

  @media (min-width: 721px) and (max-height: 950px) {
    .hero-brand {
      gap: 13px;
    }

    .hero-brand-copy h2 {
      font-size: clamp(42px, 4.45vw, 68px);
      line-height: 1.1;
    }

    .hero-actions {
      margin-top: -2px;
    }

    .hero-actions a {
      min-width: 146px;
      height: 48px;
      padding-inline: 22px;
      font-size: 14px;
    }
  }

  @media (max-width: 720px) {
    .hero {
      height: 245svh;
    }

    .hero-viewport {
      min-height: 560px;
    }

    h1 {
      font-size: clamp(43px, 12vw, 68px);
      line-height: 1.03;
    }

    .hero-brand {
      width: calc(100% - 36px);
      gap: 18px;
      text-align: center;
    }

    .hero-brand-copy {
      margin-bottom: 8px;
      text-align: center;
    }

    .hero-brand-copy p {
      font-size: clamp(21px, 6vw, 32px);
    }

    .hero-brand-copy h2 {
      margin-top: 0;
      font-size: clamp(41px, 11.2vw, 60px);
    }

    .hero-actions {
      align-self: center;
      justify-content: center;
      margin-top: 0;
    }
  }

  @media (max-width: 560px) {
    .hero-content {
      width: calc(100% - 28px);
    }

    h1 {
      font-size: clamp(38px, 11.6vw, 54px);
    }

    .hero-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
    }

    .hero-actions a {
      min-width: 0;
      padding: 0 13px;
      font-size: 13px;
    }

    .scroll-next {
      bottom: 18px;
      width: 40px;
      height: 40px;
    }
  }
</style>

<script>
  import { initHeroParticles } from '@/scripts/heroParticles'

  initHeroParticles()
</script>
