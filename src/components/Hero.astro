---
import Icon from '@/components/Icon.astro'
import { links, site } from '@/data/site'
---

<section class="hero" data-hero id="hero">
  <div class="hero-viewport" data-hero-viewport>
    <canvas aria-hidden="true" class="particle-canvas" data-hero-particles></canvas>

    <div class="hero-content" data-hero-content>
      <h1>
        사람이 떠나도,<br />
        <span>업무는 이어지도록.</span>
      </h1>
    </div>

    <div class="hero-brand" data-hero-brand inert>
      <div class="hero-brand-copy">
        <h2>
          <strong>AI 기반 인수인계</strong><br />
          자동화 서비스 <b>{site.name}</b>
        </h2>

        <div class="hero-actions">
          <a class="btn-dark btn-lg" href="#pricing">
            바톤 도입하기
            <Icon name="arrow" />
          </a>
          <a class="btn-glass btn-lg" href={links.app} rel="noreferrer" target="_blank">
            서비스 바로가기
            <Icon name="arrow" />
          </a>
        </div>
      </div>
      <img class="hero-brand-logo" alt="" src={site.logo} />
    </div>

    <a class="scroll-next" data-hero-next href="#problem" aria-label="BATON 서비스 보기">
      <Icon name="arrow" />
    </a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 255svh;
    background: var(--surface);
  }

  .hero-viewport {
    position: sticky;
    top: 0;
    overflow: hidden;
    width: 100%;
    height: 100svh;
    min-height: 620px;
    background: var(--surface);
    isolation: isolate;
  }

  .particle-canvas {
    position: absolute;
    z-index: 0;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .hero-content {
    position: absolute;
    z-index: 1;
    top: 50%;
    left: 50%;
    width: min(1040px, calc(100% - 40px));
    text-align: center;
    transform: translate(-50%, -47%);
    will-change: opacity, transform;
  }

  .hero-brand {
    position: absolute;
    z-index: 1;
    top: 50%;
    left: 50%;
    display: grid;
    width: min(1380px, calc(100% - 64px));
    grid-template-columns: minmax(0, 1.35fr) minmax(240px, 0.65fr);
    align-items: center;
    gap: clamp(28px, 5vw, 96px);
    color: var(--navy-deep);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translate(-50%, -50%) scale(0.76);
    transform-origin: center;
    will-change: opacity, transform;
  }

  .hero-brand-copy {
    text-align: left;
  }

  .hero-brand-copy p {
    margin: 0;
    color: var(--navy-deep);
    font-size: clamp(25px, 3.15vw, 50px);
    font-weight: 420;
    line-height: 1.28;
    letter-spacing: -0.045em;
  }

  .hero-brand-copy h2 {
    margin: 0;
    color: var(--navy-deep);
    font-size: clamp(44px, 5.8vw, 94px);
    font-weight: 430;
    line-height: 1.18;
    letter-spacing: -0.055em;
  }

  .hero-brand-copy h2 strong,
  .hero-brand-copy h2 b {
    font-weight: 850;
  }

  .hero-brand-copy h2 b {
    color: var(--navy-deep);
  }

  .hero-brand-logo {
    width: min(100%, 440px);
    height: auto;
    justify-self: end;
    filter: drop-shadow(0 28px 38px rgb(49 130 246 / 20%));
  }

  h1 {
    margin: 0;
    color: var(--navy-deep);
    font-size: clamp(54px, 7.2vw, 108px);
    font-weight: 850;
    line-height: 0.98;
    letter-spacing: -0.065em;
    text-shadow: 0 2px 28px rgb(255 255 255 / 92%);
  }

  h1 span {
    color: var(--blue-dark);
  }

  .hero-actions {
    display: flex;
    justify-content: flex-start;
    gap: 10px;
    margin-top: 34px;
  }

  .hero-actions a {
    min-width: 172px;
    border-radius: 999px;
    box-shadow: 0 14px 34px rgb(23 32 51 / 13%);
  }

  .hero-actions :global(svg) {
    width: 18px;
    height: 18px;
  }

  .hero-actions .btn-dark :global(svg) {
    transition: transform 0.2s var(--ease-out);
  }

  .hero-actions .btn-dark:hover :global(svg) {
    transform: translateX(3px);
  }

  .btn-glass {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border: 1px solid rgb(25 31 40 / 12%);
    background: rgb(255 255 255 / 82%);
    backdrop-filter: blur(14px);
    color: var(--body);
    font-size: 15px;
    font-weight: 750;
    text-decoration: none;
    transition: background 0.2s, transform 0.2s;
  }

  .btn-glass:hover {
    background: var(--surface);
    transform: translateY(-2px);
  }

  .btn-glass :global(svg) {
    fill: none;
    stroke: currentColor;
  }

  .scroll-next {
    position: absolute;
    z-index: 2;
    bottom: 26px;
    left: 50%;
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    transform: translateX(-50%);
    border: 1px solid rgb(25 31 40 / 18%);
    border-radius: 50%;
    background: rgb(255 255 255 / 48%);
    backdrop-filter: blur(8px);
    color: var(--navy);
    transition: opacity 0.3s, border-color 0.2s, background 0.2s;
  }

  .scroll-next:hover {
    border-color: rgb(49 130 246 / 55%);
    background: rgb(255 255 255 / 82%);
  }

  .scroll-next :global(svg) {
    width: 17px;
    height: 17px;
    transform: rotate(90deg);
    stroke-width: 1.5;
  }

  @media (max-width: 720px) {
    .hero {
      height: 245svh;
    }

    .hero-viewport {
      min-height: 560px;
    }

    h1 {
      font-size: clamp(43px, 12vw, 68px);
      line-height: 1.03;
    }

    .hero-brand {
      width: calc(100% - 36px);
      grid-template-columns: 1fr;
      gap: 34px;
      text-align: center;
    }

    .hero-brand-copy {
      text-align: center;
    }

    .hero-brand-copy p {
      font-size: clamp(21px, 6vw, 32px);
    }

    .hero-brand-copy h2 {
      margin-top: 14px;
      font-size: clamp(38px, 10.8vw, 58px);
    }

    .hero-brand-logo {
      width: min(52vw, 250px);
      justify-self: center;
    }

    .hero-actions {
      justify-content: center;
      margin-top: 26px;
    }
  }

  @media (max-width: 560px) {
    .hero-content {
      width: calc(100% - 28px);
    }

    h1 {
      font-size: clamp(38px, 11.6vw, 54px);
    }

    .hero-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
    }

    .hero-actions a {
      min-width: 0;
      padding: 0 13px;
      font-size: 13px;
    }

    .scroll-next {
      bottom: 18px;
      width: 40px;
      height: 40px;
    }
  }
</style>

<script>
  import { initHeroParticles } from '@/scripts/heroParticles'

  initHeroParticles()
</script>
