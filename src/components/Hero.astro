---
import Icon from '@/components/Icon.astro'
import { heroProof } from '@/data/content'
import { links, site } from '@/data/site'
---

<section class="hero" data-hero data-parallax-stage id="hero">
  <div aria-hidden="true" class="orbs">
    <span class="orb orb-1"></span>
    <span class="orb orb-2"></span>
    <span class="orb orb-3"></span>
  </div>

  <div class="hero-inner">
    <div class="hero-copy">
      <span class="pill hero-in" style="--i: 0">
        <Icon name="spark" />
        끊김 없는 업무, AI 기반 인수인계 자동화
      </span>

      <h1>
        <span class="hero-line hero-in" style="--i: 1"><span>업무는 남기고,</span></span>
        <span class="hero-line accent hero-in" style="--i: 2"><span>인수인계는 자동으로.</span></span>
      </h1>

      <p class="hero-sub hero-in" style="--i: 3">
        흩어진 업무 자료를 AI가 정리해 <br />다음 담당자가 바로 이어서 일할 수 있어요.
      </p>

      <div class="hero-actions hero-in" style="--i: 4">
        <a class="btn-primary btn-lg" href={links.app} rel="noreferrer" target="_blank">
          무료로 시작하기
          <Icon name="arrow" />
        </a>
        <a class="btn-outline btn-lg" href={links.demo} rel="noreferrer" target="_blank">
          <Icon name="play" />
          시연 영상 보기
        </a>
      </div>

      <ul aria-label="핵심 수치" class="hero-proof hero-in" style="--i: 5">
        {
          heroProof.map((item) => (
            <li>
              <strong>{item.value}</strong>
              <span>{item.label}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="hero-visual hero-in" data-parallax-target style="--i: 2">
      <div aria-hidden="true" class="hero-glow"></div>
      <img
        alt="흩어진 인수인계 자료가 AI를 거쳐 하나의 인수인계서로 정리되어 다음 담당자에게 전달되는 모습"
        class="hero-img"
        src={site.heroImage}
      />
      <div aria-hidden="true" class="float-card float-a"><span class="dot"></span>회의록 12건 분석 완료</div>
      <div aria-hidden="true" class="float-card float-b"><Icon name="check" />인수인계서 초안 생성됨</div>
      <div aria-hidden="true" class="float-card float-c"><em>Q</em>정산 보고는 누구에게?</div>
    </div>
  </div>

  <a aria-label="아래로 스크롤" class="scroll-hint" href="#problem"><span></span></a>
</section>

<style>
  /*
   * Icon 컴포넌트가 그린 svg는 이 컴포넌트의 scope 속성을 갖지 않습니다.
   * 그래서 자식 svg를 겨냥할 때는 :global(svg)로 감쌉니다.
   */
  .hero {
    position: relative;
    display: grid;
    min-height: 100svh;
    place-items: center;
    overflow: hidden;
    background: var(--bg);
    padding: calc(var(--nav-h) + 48px) max(6vw, 32px) 96px;
  }

  /* 배경에서 천천히 떠다니는 흐린 원 */
  .orbs {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .orb {
    position: absolute;
    border-radius: 50%;
    opacity: 0.55;
    filter: blur(60px);
    animation: drift 14s ease-in-out infinite alternate;
  }

  .orb-1 {
    width: 520px;
    height: 520px;
    top: -160px;
    left: -120px;
    background: radial-gradient(circle, var(--blue-8), transparent 70%);
  }

  .orb-2 {
    width: 460px;
    height: 460px;
    top: 10%;
    right: -140px;
    background: radial-gradient(circle, var(--blue-6), transparent 70%);
    animation-delay: -5s;
  }

  .orb-3 {
    width: 380px;
    height: 380px;
    bottom: -160px;
    left: 40%;
    background: radial-gradient(circle, var(--blue-4), transparent 70%);
    animation-delay: -9s;
  }

  .hero-inner {
    position: relative;
    display: grid;
    width: min(1180px, 100%);
    /* 왼쪽에 하한을 두어 폭이 줄 때 오른쪽 시각물이 먼저 양보하게 합니다.
       하한이 없으면 520px에 고정된 오른쪽 대신 제목이 다 눌립니다. */
    grid-template-columns: minmax(400px, 1fr) minmax(360px, 520px);
    align-items: center;
    gap: clamp(40px, 7vw, 110px);
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-bottom: 22px;
    border: 1px solid rgb(49 130 246 / 18%);
    border-radius: 999px;
    background: var(--surface);
    color: var(--blue-dark);
    padding: 8px 14px 8px 11px;
    font-size: 13px;
    font-weight: 750;
    box-shadow: 0 6px 18px rgb(49 130 246 / 8%);
  }

  .pill :global(svg) {
    width: 15px;
    height: 15px;
    animation: twinkle 2s ease-in-out infinite;
  }

  h1 {
    color: var(--navy);
    font-size: clamp(44px, 5.2vw, 72px);
    font-weight: 780;
    line-height: 1.08;
    letter-spacing: -0.055em;
  }

  /* 각 줄을 잘라내고 안쪽 span을 올려 등장시킵니다. */
  .hero-line {
    display: block;
    overflow: hidden;
    opacity: 1;
    transform: none;
    animation: none;
  }

  .hero-line > span {
    display: block;
    transform: translateY(110%);
    animation: slide-up 0.9s var(--ease-out) forwards;
    animation-delay: calc(0.2s + var(--i) * 0.12s);
  }

  .accent > span {
    background: linear-gradient(90deg, var(--blue), var(--blue-bright), var(--blue));
    background-size: 200% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: slide-up 0.9s var(--ease-out) forwards, shimmer 5s linear infinite;
    animation-delay: calc(0.2s + var(--i) * 0.12s), 1s;
  }

  .hero-sub {
    margin: 26px 0 0;
    border-left: 3px solid rgb(49 130 246 / 35%);
    padding-left: 18px;
    color: var(--sub-soft);
    font-size: 17px;
    font-weight: 500;
    line-height: 1.72;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 34px;
  }

  .hero-proof {
    display: flex;
    gap: 28px;
    margin: 40px 0 0;
    padding: 0;
    list-style: none;
  }

  .hero-proof li {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .hero-proof strong {
    color: var(--navy);
    font-size: 20px;
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .hero-proof span {
    color: var(--muted);
    font-size: 12px;
    font-weight: 600;
  }

  .hero-visual {
    position: relative;
    width: 100%;
  }

  .hero-glow {
    position: absolute;
    inset: 10% 5%;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(49 130 246 / 16%), transparent 65%);
    animation: pulse-glow 4s ease-in-out infinite;
  }

  .hero-img {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
    animation: float 6s ease-in-out infinite;
    will-change: transform;
  }

  /* 일러스트 주변에 떠 있는 상태 카드 */
  .float-card {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 1px solid rgb(25 31 40 / 7%);
    border-radius: 14px;
    background: rgb(255 255 255 / 92%);
    backdrop-filter: blur(8px);
    padding: 10px 14px;
    color: var(--body);
    font-size: 12px;
    font-weight: 750;
    opacity: 0;
    box-shadow: 0 14px 34px rgb(23 32 51 / 12%);
    animation: card-pop 0.7s var(--ease-out) forwards, float 5s ease-in-out infinite;
  }

  .float-a {
    top: 6%;
    left: -4%;
    animation-delay: 1.1s, 1.8s;
  }

  .float-b {
    top: 34%;
    right: -6%;
    animation-delay: 1.5s, 2.2s;
  }

  .float-c {
    bottom: 4%;
    left: 8%;
    animation-delay: 1.9s, 2.6s;
  }

  .float-card .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--success);
    box-shadow: 0 0 0 0 rgb(34 197 94 / 50%);
    animation: ping 1.6s ease-out infinite;
  }

  .float-card :global(svg) {
    width: 16px;
    height: 16px;
    color: var(--blue);
  }

  .float-card em {
    display: grid;
    width: 20px;
    height: 20px;
    place-items: center;
    border-radius: 6px;
    background: var(--blue);
    color: var(--on-dark);
    font-size: 11px;
    font-style: normal;
    font-weight: 800;
  }

  .scroll-hint {
    position: absolute;
    bottom: 26px;
    left: 50%;
    width: 26px;
    height: 42px;
    transform: translateX(-50%);
    border: 2px solid rgb(49 130 246 / 40%);
    border-radius: 14px;
  }

  .scroll-hint span {
    position: absolute;
    left: 50%;
    top: 7px;
    width: 4px;
    height: 8px;
    border-radius: 2px;
    background: var(--blue);
    transform: translateX(-50%);
    animation: wheel 1.6s ease-in-out infinite;
  }

  /* 히어로 요소가 순서대로 올라오는 진입 연출 */
  .hero-in {
    opacity: 0;
    transform: translateY(24px);
    animation: rise 0.9s var(--ease-out) forwards;
    animation-delay: calc(0.12s + var(--i) * 0.11s);
  }

  @media (max-width: 900px) {
    .hero {
      padding-top: calc(var(--nav-h) + 24px);
    }

    .hero-inner {
      grid-template-columns: 1fr;
      gap: 40px;
      text-align: center;
    }

    .hero-sub {
      border-left: 0;
      padding-left: 0;
    }

    .hero-actions,
    .hero-proof {
      justify-content: center;
    }

    .hero-visual {
      width: min(560px, 100%);
      margin: 0 auto;
    }
  }

  @media (max-width: 560px) {
    .hero {
      padding: calc(var(--nav-h) + 24px) 20px 72px;
    }

    h1 {
      font-size: clamp(38px, 11vw, 48px);
    }

    .hero-sub {
      font-size: 14px;
    }

    .hero-sub br {
      display: none;
    }

    .hero-proof {
      gap: 18px;
    }

    .float-a,
    .float-c {
      left: 0;
    }

    .float-b {
      right: 0;
    }
  }
</style>

<script>
  import { initParallax } from '@/scripts/parallax'

  initParallax()
</script>
