---
/**
 * 이용약관과 개인정보처리방침이 함께 쓰는 문서 페이지 껍데기.
 * 본문은 src/data/legal.ts에 있고 여기서는 배치만 담당합니다.
 * 섹션 내비게이션이 필요 없는 페이지라 상단은 브랜드와 홈 링크만 둡니다.
 */
import Icon from '@/components/Icon.astro'
import { legalEntity, type LegalDoc } from '@/data/legal'
import { site } from '@/data/site'

interface Props {
  doc: LegalDoc
  /** 함께 보기 링크로 걸 상대 문서 */
  sibling: { href: string; label: string }
}

const { doc, sibling } = Astro.props
---

<header class="legal-nav">
  <a aria-label={`${site.name} 홈`} class="legal-brand" href="/">
    <span class="legal-mark"><img alt="" src={site.logo} /></span>
    <strong>{site.name}</strong>
  </a>

  <a class="btn-ghost legal-home" href="/">
    <Icon name="arrow" />
    홈으로
  </a>
</header>

<main class="legal">
  <div class="legal-inner">
    <p class="legal-kicker">{legalEntity.service} · {legalEntity.operator}</p>
    <h1>{doc.title}</h1>
    <p class="legal-date">시행일 {doc.effectiveDate}</p>

    {doc.intro.map((text) => <p class="legal-intro">{text}</p>)}

    {
      doc.sections.map((section) => (
        <section class="legal-section">
          <h2>{section.heading}</h2>

          {section.paragraphs?.map((text) => <p>{text}</p>)}

          {section.list && (
            <ul>
              {section.list.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          )}

          {section.table && (
            <div class="legal-table-wrap">
              <table>
                <thead>
                  <tr>
                    {section.table.head.map((cell) => (
                      <th scope="col">{cell}</th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {section.table.rows.map((row) => (
                    <tr>
                      {row.map((cell, i) =>
                        i === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>,
                      )}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}

          {section.callout && <p class="legal-callout">{section.callout}</p>}
        </section>
      ))
    }

    <nav class="legal-foot" aria-label="관련 문서">
      <a href={sibling.href}>{sibling.label}</a>
      <a href="/">홈으로 돌아가기</a>
    </nav>
  </div>
</main>

<style>
  .legal-nav {
    position: sticky;
    z-index: 30;
    top: 0;
    display: flex;
    height: var(--nav-h);
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--line);
    background: rgb(255 255 255 / 88%);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    padding: 0 max(6vw, 32px);
  }

  .legal-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--navy);
    font-size: 17px;
    font-weight: 800;
    letter-spacing: 0.025em;
    text-decoration: none;
  }

  .legal-mark {
    display: grid;
    width: 38px;
    height: 38px;
    place-items: center;
    border: 1px solid rgb(49 130 246 / 11%);
    border-radius: 12px;
    background: linear-gradient(145deg, var(--surface), var(--blue-2));
  }

  .legal-mark img {
    width: 30px;
    height: 30px;
    object-fit: contain;
  }

  .legal-home {
    height: 40px;
    font-size: 13px;
  }

  /* 홈으로 가는 화살표라 왼쪽을 보게 뒤집습니다. */
  .legal-home :global(svg) {
    width: 16px;
    height: 16px;
    transform: rotate(180deg);
  }

  .legal {
    background: var(--surface);
    padding: 72px max(6vw, 32px) 120px;
  }

  .legal-inner {
    max-width: 760px;
    margin: 0 auto;
  }

  .legal-kicker {
    margin: 0 0 12px;
    color: var(--blue-dark);
    font-size: 13px;
    font-weight: 750;
  }

  h1 {
    margin: 0;
    color: var(--text);
    font-size: clamp(30px, 5vw, 40px);
    letter-spacing: -0.02em;
  }

  .legal-date {
    margin: 12px 0 0;
    color: var(--muted);
    font-size: 14px;
  }

  .legal-intro {
    margin: 20px 0 0;
    color: var(--sub);
    font-size: 16px;
    line-height: 1.75;
  }

  .legal-section {
    margin-top: 52px;
  }

  h2 {
    margin: 0 0 16px;
    color: var(--text);
    font-size: 20px;
    font-weight: 800;
    letter-spacing: -0.01em;
  }

  .legal-section p {
    margin: 0 0 14px;
    color: var(--body);
    font-size: 15px;
    line-height: 1.8;
  }

  .legal-section ul {
    margin: 0 0 14px;
    padding-left: 20px;
    color: var(--body);
    font-size: 15px;
    line-height: 1.8;
  }

  .legal-section li {
    margin-bottom: 8px;
  }

  .legal-section li::marker {
    color: var(--blue);
  }

  /* 표는 좁은 화면에서 본문을 밀지 않도록 자기 안에서만 가로 스크롤합니다. */
  .legal-table-wrap {
    overflow-x: auto;
    margin: 0 0 14px;
    border: 1px solid var(--line);
    border-radius: 14px;
  }

  table {
    min-width: 440px;
    border-collapse: collapse;
    font-size: 14px;
  }

  th,
  td {
    border-bottom: 1px solid var(--line);
    padding: 13px 16px;
    line-height: 1.7;
    text-align: left;
    vertical-align: top;
  }

  thead th {
    background: var(--bg-soft);
    color: var(--sub);
    font-weight: 750;
    white-space: nowrap;
  }

  tbody th {
    color: var(--text);
    font-weight: 700;
    white-space: nowrap;
  }

  tbody td {
    color: var(--body);
  }

  tbody tr:last-child th,
  tbody tr:last-child td {
    border-bottom: 0;
  }

  .legal-callout {
    margin: 18px 0 0;
    border-left: 3px solid var(--blue);
    border-radius: 0 12px 12px 0;
    background: var(--blue-1);
    padding: 16px 18px;
    color: var(--body);
    font-size: 14px;
    font-weight: 600;
    line-height: 1.75;
  }

  .legal-foot {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 24px;
    margin-top: 64px;
    border-top: 1px solid var(--line);
    padding-top: 28px;
  }

  .legal-foot a {
    color: var(--blue-dark);
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
  }

  .legal-foot a:hover {
    text-decoration: underline;
  }

  @media (max-width: 720px) {
    .legal {
      padding: 52px max(5vw, 20px) 96px;
    }

    .legal-section {
      margin-top: 40px;
    }
  }

  @media (max-width: 560px) {
    .legal-nav {
      padding: 0 16px;
    }

    .legal-home {
      height: 36px;
      padding: 0 12px;
    }
  }
</style>
