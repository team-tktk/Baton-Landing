---
import { pilotDeadline } from '@/data/site'
---

<div
  aria-label="파일럿 신청"
  class="cta-bar"
  data-cta-bar
  data-deadline={pilotDeadline}
  role="region"
>
  <div class="cta-copy">
    <strong>BATON 파일럿 기업 모집</strong>
    <small>파일럿 모집 마감까지 <span class="countdown" data-countdown>--일 --시간 --분 --초</span></small>
  </div>

  <a class="btn-dark cta-btn" href="#pricing">무료로 도입하기</a>

  <button aria-label="채널톡으로 문의하기" class="btn-dark cta-btn cta-inquiry" data-channel-direct type="button">문의하기</button>
</div>

<style>
  /* 히어로를 지나면 스크립트가 .show를 붙여 올립니다. */
  .cta-bar {
    position: fixed;
    z-index: 25;
    bottom: 18px;
    left: 50%;
    display: flex;
    width: min(1000px, calc(100% - 28px));
    align-items: center;
    gap: 14px;
    border: 1px solid rgb(255 255 255 / 68%);
    border-radius: 18px;
    background: rgb(255 255 255 / 76%);
    backdrop-filter: blur(20px) saturate(1.15);
    -webkit-backdrop-filter: blur(20px) saturate(1.15);
    padding: 12px 12px 12px 22px;
    opacity: 0;
    transform: translate(-50%, 140%);
    box-shadow: 0 18px 50px rgb(23 32 51 / 16%);
    transition: transform 0.6s var(--ease-out), opacity 0.4s;
  }

  .cta-bar.show {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  .cta-copy {
    display: flex;
    min-width: 0;
    flex: 1;
    flex-direction: column;
    gap: 3px;
  }

  .cta-copy strong {
    color: var(--navy);
    font-size: 14px;
    font-weight: 800;
  }

  .cta-copy small {
    overflow: hidden;
    color: var(--sub);
    font-size: 12px;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .countdown {
    color: var(--blue-dark);
    font-weight: 800;
    font-variant-numeric: tabular-nums;
  }

  .cta-btn {
    height: 48px;
    flex: none;
    padding: 0 26px;
  }

  .cta-inquiry {
    padding: 0 20px;
  }

  @media (max-width: 560px) {
    .cta-bar {
      bottom: 12px;
      width: calc(100% - 20px);
      gap: 8px;
      padding: 10px 10px 10px 14px;
    }

    .cta-copy small {
      display: none;
    }

    .cta-btn {
      padding: 0 16px;
    }
  }
</style>

<script>
  import { initCtaBar } from '@/scripts/ctaBar'

  initCtaBar()
</script>
