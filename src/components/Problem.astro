---
import Section from '@/components/Section.astro'
import { stats } from '@/data/content'
---

<Section id="problem" index="01. 문제 인식" kicker="담당자가 바뀐 때마다 사라지는 업무 맥락">
  <Fragment slot="title">자료는 남아도, <b>업무의 맥락은 사람과 함께 사라집니다</b></Fragment>

  <ul class="evidence-strip">
    {
      stats.map((stat, index) => (
        <li class="evidence-item reveal" style={`--d: ${index}`}>
          <div class="evidence-topline"><span>{String(index + 1).padStart(2, '0')}</span></div>
          <strong>{stat.prefix}{stat.count}{stat.suffix}</strong>
          <p>{stat.label}</p>
          {
            stat.sourceUrl ? (
              <a href={stat.sourceUrl} rel="noreferrer" target="_blank">{stat.source}<span>↗</span></a>
            ) : (
              <small>{stat.source}</small>
            )
          }
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .evidence-strip {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    overflow: hidden;
    margin: 0;
    border: 1px solid var(--line);
    border-radius: 28px;
    background: var(--surface);
    padding: 0;
    list-style: none;
    box-shadow: 0 18px 50px rgb(23 32 51 / 7%);
  }

  .evidence-item {
    min-height: 290px;
    border-left: 1px solid var(--line);
    padding: 32px;
  }

  .evidence-item:first-child { border-left: 0; }

  .evidence-topline {
    display: flex;
    align-items: center;
    margin-bottom: 48px;
    color: var(--blue);
    font-size: 12px;
    font-weight: 800;
  }

  .evidence-item strong {
    display: block;
    margin-bottom: 14px;
    color: var(--blue);
    font-size: clamp(48px, 5vw, 68px);
    line-height: 0.95;
    letter-spacing: -0.055em;
    font-variant-numeric: tabular-nums;
  }

  .evidence-item p {
    min-height: 50px;
    margin: 0 0 26px;
    color: var(--body);
    font-size: 16px;
    font-weight: 650;
    line-height: 1.55;
  }

  .evidence-item a,
  .evidence-item small {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.5;
    text-decoration: none;
  }

  .evidence-item a { transition: color 0.18s; }

  .evidence-item a:hover { color: var(--blue-dark); text-decoration: underline; }

  @media (max-width: 720px) {
    .evidence-strip { grid-template-columns: 1fr; }
    .evidence-item { min-height: auto; border-top: 1px solid var(--line); border-left: 0; padding: 28px; }
    .evidence-item:first-child { border-top: 0; }
    .evidence-topline { margin-bottom: 26px; }
    .evidence-item p { min-height: 0; }
  }
</style>
