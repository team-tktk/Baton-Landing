---
import CtaBar from '@/components/CtaBar.astro'
import Difference from '@/components/Difference.astro'
import Features from '@/components/Features.astro'
import FinalCta from '@/components/FinalCta.astro'
import Footer from '@/components/Footer.astro'
import Hero from '@/components/Hero.astro'
import Interviews from '@/components/Interviews.astro'
import Nav from '@/components/Nav.astro'
import Pricing from '@/components/Pricing.astro'
import Problem from '@/components/Problem.astro'
import Roadmap from '@/components/Roadmap.astro'
import Solution from '@/components/Solution.astro'
import CostSavings from '@/components/CostSavings.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
---

<BaseLayout>
  <Nav />

  <main id="top">
    <Hero />
    <Problem />
    <Interviews />
    <Solution />
    <CostSavings />
    <Features />
    <Difference />
    <Pricing />
    <Roadmap />
    <FinalCta />
  </main>

  <Footer />
  <CtaBar />
</BaseLayout>
